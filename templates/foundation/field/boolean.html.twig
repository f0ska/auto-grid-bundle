{% import attributes.template.icons|default(ag_template('icons')) as ag_icons %}
{% block autogrid_field_boolean_content %}
    <span style="display: inline-flex; align-items: center; gap: 0.4rem; cursor: default;">
        <span class="label {{ value ? 'success' : 'secondary' }}" style="width: 1.2rem; height: 1.2rem; padding: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 4px; font-size: 0.75rem; margin: 0;">
            {{ value ? ag_icons.boolean_true() : ag_icons.boolean_false() }}
        </span>
        <span style="color: {{ value ? '#0a0a0a' : '#8a8a8a' }};">
            {{- (value ? 'f0ska.autogrid.choice.yes' : 'f0ska.autogrid.choice.no')|trans -}}
        </span>
    </span>
{% endblock %}
