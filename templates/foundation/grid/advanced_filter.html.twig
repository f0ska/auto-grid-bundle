{% import attributes.template.icons|default(ag_template('icons')) as ag_icons %}
{% if view.advancedFilterFormView and ag_run(agIsGranted, 'advanced_filter') %}
{% set advancedFilterDisplay = attributes.advanced_filter|default(false) is iterable ? attributes.advanced_filter|default({}).display|default('modal') : 'modal' %}
{% set advancedFilterCollapsed = attributes.advanced_filter|default(false) is iterable ? attributes.advanced_filter|default({}).collapsed|default(true) : true %}
{% set advancedFilterOpen = request.filter is defined or not advancedFilterCollapsed %}
{% if advancedFilterDisplay == 'inline' %}
<details class="callout" {% if advancedFilterOpen %}open{% endif %}>
    <summary style="cursor: pointer; font-weight: 600;">
        {{ ag_icons.search() }}
        {% if attributes.title is not empty %}
            {{ attributes.title|trans }}
        {% endif %}
    </summary>
    <div class="grid-x grid-padding-x" style="margin-top: 1rem;">
        <div class="cell">
            {% if view.formThemes is not empty %}
                {% form_theme view.advancedFilterFormView with view.formThemes %}
            {% endif %}
            {{ form_start(view.advancedFilterFormView) }}
            {{ include(attributes.template.grid.advanced_filter_fields|default(ag_template('grid.advanced_filter_fields'))) }}
            {{ form_rest(view.advancedFilterFormView) }}
            {{ form_end(view.advancedFilterFormView) }}
        </div>
        <div class="cell">
            <div class="grid-x grid-padding-x">
                <div class="cell medium-6">
                    <button type="submit"
                            form="{{ view.advancedFilterFormView.vars.attr.id }}"
                            class="button primary expanded"
                    >
                        {{- 'f0ska.autogrid.button.submit'|trans -}}
                    </button>
                </div>
                <div class="cell medium-6">
                    <a class="button secondary expanded {% if request.filter is not defined %}disabled{% endif %}"
                       href="{{ ag_run(agActionUrl, 'grid', {'filter': null}) }}"
                    >
                        {{- 'f0ska.autogrid.button.reset'|trans -}}
                    </a>
                </div>
            </div>
        </div>
    </div>
</details>
{% else %}
<div id="adv{{ agId }}" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 2000; background: rgba(0,0,0,0.5);">
    <div style="position: relative; max-width: 900px; margin: 100px auto; background: white; border-radius: 4px; padding: 20px;">
        <div class="grid-x grid-padding-x">
            <div class="cell">
                <h3>
                    {{ ag_icons.search() }}
                    {% if attributes.title is not empty %}
                        {{ attributes.title|trans }}
                    {% endif %}
                </h3>
                <button class="close-button" aria-label="Close modal" type="button" onclick="document.getElementById('adv{{ agId }}').style.display='none';">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="cell">
                {% if view.formThemes is not empty %}
                    {% form_theme view.advancedFilterFormView with view.formThemes %}
                {% endif %}
                {{ form_start(view.advancedFilterFormView) }}
                {{ include(attributes.template.grid.advanced_filter_fields|default(ag_template('grid.advanced_filter_fields'))) }}
                {{ form_rest(view.advancedFilterFormView) }}
                {{ form_end(view.advancedFilterFormView) }}
            </div>
            <div class="cell">
                <div class="grid-x grid-padding-x">
                    <div class="cell medium-6">
                        <button type="submit"
                                form="{{ view.advancedFilterFormView.vars.attr.id }}"
                                class="button primary expanded"
                        >
                            {{- 'f0ska.autogrid.button.submit'|trans -}}
                        </button>
                    </div>
                    <div class="cell medium-6">
                        <a class="button secondary expanded {% if request.filter is not defined %}disabled{% endif %}"
                           href="{{ ag_run(agActionUrl, 'grid', {'filter': null}) }}"
                        >
                            {{- 'f0ska.autogrid.button.reset'|trans -}}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}
{% endif %}
