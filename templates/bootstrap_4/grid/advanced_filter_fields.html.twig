{% block autogrid_grid_advanced_filter_fields %}
    <div class="row">
        {% for field in fields %}
            {% if field.canFilter %}
                {% set formField = attribute(view.advancedFilterFormView, field.name) %}
                {% block autogrid_grid_advanced_filter_field %}
                    {% if formField.children|length %}
                        {% for child in formField.children %}
                            <div class="col col-12 col-xl-4 col-lg-6 mb-3">
                                <label class="form-label">{{ field_label(formField) }} - {{ field_label(child) }}</label>
                                {{ form_widget(child) }}
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="col col-12 col-xl-4 col-lg-6 mb-3">
                            <label class="form-label">{{ field_label(formField) }}</label>
                            {{ form_widget(formField) }}
                        </div>
                    {% endif %}
                {% endblock %}
            {% endif %}
        {% endfor %}
    </div>
{% endblock %}
