{% import attributes.template.icons|default(ag_template('icons')) as ag_icons %}
{% if view.advancedFilterFormView and ag_run(agIsGranted, 'advanced_filter') %}
    {% set advancedFilterDisplay = attributes.advanced_filter|default(false) is iterable ? attributes.advanced_filter|default({}).display|default('modal') : 'modal' %}
    {% set advancedFilterCollapsed = attributes.advanced_filter|default(false) is iterable ? attributes.advanced_filter|default({}).collapsed|default(true) : true %}
    {% set advancedFilterOpen = request.filter is defined or not advancedFilterCollapsed %}
    {% if advancedFilterDisplay == 'inline' %}
        {% block autogrid_grid_advanced_filter_inline %}
            <style>
                .autogrid-inline-details summary {
                    list-style: none; /* remove summary marker */
                }
                .autogrid-inline-details summary::-webkit-details-marker {
                    display: none; /* remove safari summary marker */
                }
                .autogrid-inline-details {
                    margin-left: auto;
                }
                .autogrid-inline-details[open] {
                    width: 100%;
                    display: block;
                    margin-top: 1rem;
                    margin-left: 0 !important;
                    margin-right: 0 !important;
                    background-color: #ffffff;
                    border: 1px solid #e5e7eb;
                    border-radius: 0.75rem;
                    overflow: hidden;
                }
                .autogrid-inline-details[open] summary {
                    display: flex !important;
                    align-items: center !important;
                    gap: 0.5rem !important;
                    padding: 0.75rem 1rem !important;
                    background-color: #f9fafb !important;
                    border: none !important;
                    border-bottom: 1px solid #e5e7eb !important;
                    color: #111827 !important;
                    font-weight: 500 !important;
                    cursor: pointer !important;
                    width: 100% !important;
                    border-radius: 0 !important;
                    outline: none !important;
                    box-shadow: none !important;
                }
                .autogrid-inline-details[open] summary::after {
                    content: "";
                    display: inline-block;
                    width: 0.45rem;
                    height: 0.45rem;
                    border-right: 2px solid currentColor;
                    border-bottom: 2px solid currentColor;
                    transform: rotate(-135deg); /* Chevron pointing up */
                    margin-left: auto;
                    margin-right: 0.25rem;
                    transition: transform 0.2s ease;
                }
                .autogrid-inline-details[open] summary .ag-filter-ellipsis {
                    display: none !important;
                }
                .autogrid-inline-filter-content {
                    width: 100%;
                }
            </style>
            <details class="autogrid-inline-details mb-0" {% if advancedFilterOpen %}open{% endif %}>
                <summary class="inline-flex cursor-pointer items-center gap-1 rounded-full border border-dashed border-gray-300 bg-gray-50/50 px-3 py-1.5 text-sm font-medium text-gray-600 hover:border-blue-500 hover:bg-blue-50/40 hover:text-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-100 transition-all duration-200">
                    {{ ag_icons.filter(1.6) }}
                    <span>{{ 'f0ska.autogrid.button.advanced_filter'|trans }}<span class="ag-filter-ellipsis">...</span></span>
                </summary>
                <div class="autogrid-inline-filter-content p-6 bg-white">
                    {% if view.formThemes is not empty %}
                        {% form_theme view.advancedFilterFormView with view.formThemes %}
                    {% endif %}
                    {% block autogrid_grid_advanced_filter_inline_form %}
                        {{ form_start(view.advancedFilterFormView) }}
                        {{ include(attributes.template.grid.advanced_filter_fields|default(ag_template('grid.advanced_filter_fields'))) }}
                        {{ form_rest(view.advancedFilterFormView) }}
                        {{ form_end(view.advancedFilterFormView) }}
                    {% endblock %}
                    
                    <div class="flex items-center mt-4 space-x-2">
                        <div class="flex-1">
                            <button type="submit"
                                    form="{{ view.advancedFilterFormView.vars.attr.id }}"
                                    class="cursor-pointer text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center w-full"
                            >
                                {{- 'f0ska.autogrid.button.submit'|trans -}}
                            </button>
                        </div>
                        <div class="flex-1">
                            <a class="{% if request.filter is not defined %}opacity-50 cursor-not-allowed {% endif %}text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-200 rounded-lg text-sm font-medium px-5 py-2.5 text-center w-full block"
                               href="{{ ag_run(agActionUrl, 'grid', {'filter': null}) }}"
                            >
                                {{- 'f0ska.autogrid.button.reset'|trans -}}
                            </a>
                        </div>
                    </div>
                </div>
            </details>
        {% endblock %}
    {% else %}
    {% block autogrid_grid_advanced_filter_modal %}
        <div id="adv{{ agId }}" tabindex="-1" aria-hidden="true" style="display: none; overflow-y: auto; overflow-x: hidden; position: fixed; top: 0; right: 0; left: 0; z-index: 50; justify-content: center; align-items: center; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5);">
            <div class="relative p-4 w-full max-w-4xl h-full md:h-auto">
                {% block autogrid_grid_advanced_filter_dialog %}
                    <div class="relative bg-white rounded-lg shadow">
                        {% block autogrid_grid_advanced_filter_content %}
                            <div class="flex justify-between items-start p-4 rounded-t border-b">
                                {% block autogrid_grid_advanced_filter_header %}
                                    <h3 class="text-xl font-semibold text-gray-900">
                                        {{ ag_icons.filter() }}
                                        {{ 'f0ska.autogrid.button.advanced_filter'|trans }}
                                    </h3>
                                    <button type="button" onclick="document.getElementById('adv{{ agId }}').style.display='none';" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 ml-auto inline-flex items-center">
                                        ✕
                                    </button>
                                {% endblock %}
                            </div>

                            {% block autogrid_grid_advanced_filter_body %}
                                <div class="p-6 space-y-6">
                                    {% if view.formThemes is not empty %}
                                        {% form_theme view.advancedFilterFormView with view.formThemes %}
                                    {% endif %}
                                    {% block autogrid_grid_advanced_filter_form %}
                                        {{ form_start(view.advancedFilterFormView) }}
                                        {{ include(attributes.template.grid.advanced_filter_fields|default(ag_template('grid.advanced_filter_fields'))) }}
                                        {{ form_rest(view.advancedFilterFormView) }}
                                        {{ form_end(view.advancedFilterFormView) }}
                                    {% endblock %}
                                </div>
                            {% endblock %}

                            {% block autogrid_grid_advanced_filter_footer %}
                                <div class="flex items-center p-6 space-x-2 rounded-b border-t border-gray-200">
                                    <div class="flex-1">
                                        {% block autogrid_grid_advanced_filter_submit_button %}
                                            <button type="submit"
                                                    form="{{ view.advancedFilterFormView.vars.attr.id }}"
                                                    class="cursor-pointer text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center w-full"
                                            >
                                                {{- 'f0ska.autogrid.button.submit'|trans -}}
                                            </button>
                                        {% endblock %}
                                    </div>
                                    <div class="flex-1">
                                        {% block autogrid_grid_advanced_filter_reset_button %}
                                            <a class="{% if request.filter is not defined %}opacity-50 cursor-not-allowed {% endif %}text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-200 rounded-lg text-sm font-medium px-5 py-2.5 text-center w-full block"
                                               href="{{ ag_run(agActionUrl, 'grid', {'filter': null}) }}"
                                            >
                                                {{- 'f0ska.autogrid.button.reset'|trans -}}
                                            </a>
                                        {% endblock %}
                                    </div>
                                </div>
                            {% endblock %}
                        {% endblock %}
                    </div>
                {% endblock %}
            </div>
        </div>
    {% endblock %}
    {% endif %}
{% endif %}
