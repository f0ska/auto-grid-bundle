{% if field.permissions.grid %}
    {% block autogrid_grid_column_value_cell %}
        <td class="{{ ag_column_class(field, 'value', 'align-middle') }}">
            {% block autogrid_grid_column_value_content %}
                {% set agView = field|ag_prepare(entity) %}
                {{ include(agView.template, agView.variables) }}
            {% endblock %}
        </td>
    {% endblock %}
{% endif %}
