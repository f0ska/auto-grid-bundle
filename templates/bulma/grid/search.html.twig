{% if view.searchFormView and ag_run(agIsGranted, 'search') %}
    {% if view.formThemes is not empty %}
        {% form_theme view.searchFormView with view.formThemes %}
    {% endif %}
    <div style="display: contents;">
        {{ form_start(view.searchFormView, {'attr': {'style': 'display: contents;'}}) }}
            <div class="field has-addons" style="width: 100%; margin-bottom: 0;">
                <div class="control is-expanded">
                    {{ form_widget(view.searchFormView.term, {'attr': {'class': 'input', 'placeholder': 'f0ska.autogrid.placeholder.search'|trans}}) }}
                </div>
                <div class="control">
                    <button class="button is-primary" type="submit">
                        {{- 'f0ska.autogrid.button.submit'|trans -}}
                    </button>
                </div>
                <div class="control">
                    <a class="button is-light {% if request.search is not defined %}is-static{% endif %}"
                       href="{{ ag_run(agActionUrl, 'grid', {'search': null, 'page': null}) }}"
                    >
                        {{- 'f0ska.autogrid.button.reset'|trans -}}
                    </a>
                </div>
            </div>
            {% if view.searchFormView.fields is defined %}
                <div class="is-flex is-align-items-center mb-0" style="gap: 0.75rem; margin-left: 1.5rem;">
                    {% for field in view.searchFormView.fields %}
                        <label class="checkbox has-text-grey is-size-7" style="display: inline-flex; align-items: center; gap: 0.25rem; margin-bottom: 0;">
                            {{ form_widget(field, {'attr': {'style': 'margin: 0;'}}) }}
                            <span>{{ field.vars.label|trans }}</span>
                        </label>
                    {% endfor %}
                </div>
            {% endif %}
        {{ form_end(view.searchFormView) }}
    </div>
{% endif %}
