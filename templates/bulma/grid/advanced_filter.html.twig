{% import attributes.template.icons|default(ag_template('icons')) as ag_icons %}
{% if view.advancedFilterFormView and ag_run(agIsGranted, 'advanced_filter') %}
    {% set advancedFilterDisplay = attributes.advanced_filter|default(false) is iterable ? attributes.advanced_filter|default({}).display|default('modal') : 'modal' %}
    {% set advancedFilterCollapsed = attributes.advanced_filter|default(false) is iterable ? attributes.advanced_filter|default({}).collapsed|default(true) : true %}
    {% set advancedFilterOpen = request.filter is defined or not advancedFilterCollapsed %}
    {% if advancedFilterDisplay == 'inline' %}
        {% block autogrid_grid_advanced_filter_inline %}
            <style>
                .autogrid-inline-details summary {
                    list-style: none; /* remove summary marker */
                    gap: 0.5rem;
                    cursor: pointer !important;
                }
                .autogrid-inline-details summary::-webkit-details-marker {
                    display: none; /* remove safari summary marker */
                }
                .autogrid-inline-details {
                    margin-left: auto;
                }
                .autogrid-filter-link:hover {
                    color: #485fc7 !important;
                    text-decoration: underline !important;
                }
                .autogrid-inline-details[open] {
                    width: 100%;
                    display: block;
                    margin-top: 1rem;
                    margin-left: 0 !important;
                    margin-right: 0 !important;
                    background-color: #ffffff;
                    border: 1px solid #dbdbdb;
                    border-radius: 6px;
                    overflow: hidden;
                }
                .autogrid-inline-details[open] summary {
                    display: flex !important;
                    align-items: center !important;
                    gap: 0.5rem !important;
                    padding: 0.75rem 1rem !important;
                    background-color: #f5f5f5 !important;
                    border: none !important;
                    border-bottom: 1px solid #dbdbdb !important;
                    color: #363636 !important;
                    font-weight: 500 !important;
                    cursor: pointer !important;
                    width: 100% !important;
                    border-radius: 0 !important;
                    outline: none !important;
                    box-shadow: none !important;
                    font-size: 0.875rem !important;
                }
                .autogrid-inline-details[open] summary::after {
                    content: "";
                    display: inline-block;
                    width: 0.45rem;
                    height: 0.45rem;
                    border-right: 2px solid currentColor;
                    border-bottom: 2px solid currentColor;
                    transform: rotate(-135deg); /* Chevron pointing up */
                    margin-left: auto;
                    margin-right: 0.25rem;
                    transition: transform 0.2s ease;
                }
                .autogrid-inline-details[open] summary .ag-filter-ellipsis {
                    display: none !important;
                }
                .autogrid-inline-filter-content {
                    width: 100%;
                }
            </style>
            <details class="autogrid-inline-details mb-0" {% if advancedFilterOpen %}open{% endif %}>
                <summary class="is-inline-flex is-align-items-center cursor-pointer autogrid-filter-link" style="gap: 0.25rem; font-size: 0.875rem; color: #4a4a4a; outline: none; border: none; background: transparent; cursor: pointer !important;">
                    {{ ag_icons.filter() }}
                    <span>{{ 'f0ska.autogrid.button.advanced_filter'|trans }}<span class="ag-filter-ellipsis">...</span></span>
                </summary>
                <div class="autogrid-inline-filter-content p-4" style="box-sizing: border-box;">
                    {% if view.formThemes is not empty %}
                        {% form_theme view.advancedFilterFormView with view.formThemes %}
                    {% endif %}
                    {% block autogrid_grid_advanced_filter_inline_form %}
                        {{ form_start(view.advancedFilterFormView) }}
                        {{ include(attributes.template.grid.advanced_filter_fields|default(ag_template('grid.advanced_filter_fields'))) }}
                        {{ form_rest(view.advancedFilterFormView) }}
                        {{ form_end(view.advancedFilterFormView) }}
                    {% endblock %}
                    <div class="field is-grouped columns">
                        <div class="control column is-6">
                            <button type="submit"
                                    form="{{ view.advancedFilterFormView.vars.attr.id }}"
                                    class="button is-primary is-fullwidth"
                            >
                                {{- 'f0ska.autogrid.button.submit'|trans -}}
                            </button>
                        </div>
                        <div class="control column is-6">
                            <a class="button is-light is-fullwidth {% if request.filter is not defined %}is-static{% endif %}"
                               href="{{ ag_run(agActionUrl, 'grid', {'filter': null}) }}"
                            >
                                {{- 'f0ska.autogrid.button.reset'|trans -}}
                            </a>
                        </div>
                    </div>
                </div>
            </details>
        {% endblock %}
    {% else %}
    {% block autogrid_grid_advanced_filter_modal %}
        <div id="adv{{ agId }}" class="modal">
            {% block autogrid_grid_advanced_filter_dialog %}
                <div class="modal-background" onclick="document.getElementById('adv{{ agId }}').classList.remove('is-active');"></div>
                <style>
                    #adv{{ agId }} .modal-card {
                        max-width: 90vw;
                        width: 1200px;
                    }
                </style>
                <div class="modal-card">
                    {% block autogrid_grid_advanced_filter_content %}
                        <header class="modal-card-head">
                            {% block autogrid_grid_advanced_filter_header %}
                                <p class="modal-card-title" id="adv{{ agId }}Label">
                                    {{ ag_icons.filter() }}
                                    {{ 'f0ska.autogrid.button.advanced_filter'|trans }}
                                </p>
                                <button class="delete" aria-label="close" onclick="document.getElementById('adv{{ agId }}').classList.remove('is-active');"></button>
                            {% endblock %}
                        </header>
                        <section class="modal-card-body">
                            {% block autogrid_grid_advanced_filter_body %}
                                {% if view.formThemes is not empty %}
                                    {% form_theme view.advancedFilterFormView with view.formThemes %}
                                {% endif %}
                                {% block autogrid_grid_advanced_filter_form %}
                                    {{ form_start(view.advancedFilterFormView) }}
                                    {{ include(attributes.template.grid.advanced_filter_fields|default(ag_template('grid.advanced_filter_fields'))) }}
                                    {{ form_rest(view.advancedFilterFormView) }}
                                    {{ form_end(view.advancedFilterFormView) }}
                                {% endblock %}
                            {% endblock %}
                        </section>
                        <footer class="modal-card-foot">
                            {% block autogrid_grid_advanced_filter_footer %}
                                <div class="column is-6">
                                    {% block autogrid_grid_advanced_filter_submit_button %}
                                        <button type="submit"
                                                form="{{ view.advancedFilterFormView.vars.attr.id }}"
                                                class="button is-primary is-fullwidth"
                                        >
                                            {{- 'f0ska.autogrid.button.submit'|trans -}}
                                        </button>
                                    {% endblock %}
                                </div>
                                <div class="column is-6">
                                    {% block autogrid_grid_advanced_filter_reset_button %}
                                        <a class="button is-light is-fullwidth {% if request.filter is not defined %}is-static{% endif %}"
                                           href="{{ ag_run(agActionUrl, 'grid', {'filter': null}) }}"
                                        >
                                            {{- 'f0ska.autogrid.button.reset'|trans -}}
                                        </a>
                                    {% endblock %}
                                </div>
                            {% endblock %}
                        </footer>
                    {% endblock %}
                </div>
            {% endblock %}
        </div>
    {% endblock %}
    {% endif %}
{% endif %}
