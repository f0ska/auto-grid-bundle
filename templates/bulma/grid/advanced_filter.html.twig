{% import attributes.template.icons|default(ag_template('icons')) as ag_icons %}
{% if view.advancedFilterFormView and ag_run(agIsGranted, 'advanced_filter') %}
    {% set advancedFilterDisplay = attributes.advanced_filter|default(false) is iterable ? attributes.advanced_filter|default({}).display|default('modal') : 'modal' %}
    {% set advancedFilterCollapsed = attributes.advanced_filter|default(false) is iterable ? attributes.advanced_filter|default({}).collapsed|default(true) : true %}
    {% set advancedFilterOpen = request.filter is defined or not advancedFilterCollapsed %}
    {% if advancedFilterDisplay == 'inline' %}
        {% block autogrid_grid_advanced_filter_inline %}
            <details class="is-shadowless mb-4" style="border: 1px solid #dbdbdb; border-radius: 6px;" {% if advancedFilterOpen %}open{% endif %}>
                <summary class="is-flex is-align-items-center has-text-grey" style="cursor: pointer; gap: .5rem; font-size: .875rem; padding: .5rem .75rem;">
                    {{ ag_icons.filter() }}
                    {{ 'f0ska.autogrid.button.filter'|trans }}
                </summary>
                <div class="p-4" style="box-sizing: border-box;">
                    {% if view.formThemes is not empty %}
                        {% form_theme view.advancedFilterFormView with view.formThemes %}
                    {% endif %}
                    {% block autogrid_grid_advanced_filter_inline_form %}
                        {{ form_start(view.advancedFilterFormView) }}
                        {{ include(attributes.template.grid.advanced_filter_fields|default(ag_template('grid.advanced_filter_fields'))) }}
                        {{ form_rest(view.advancedFilterFormView) }}
                        {{ form_end(view.advancedFilterFormView) }}
                    {% endblock %}
                    <div class="field is-grouped columns">
                        <div class="control column is-6">
                            <button type="submit"
                                    form="{{ view.advancedFilterFormView.vars.attr.id }}"
                                    class="button is-primary is-fullwidth"
                            >
                                {{- 'f0ska.autogrid.button.submit'|trans -}}
                            </button>
                        </div>
                        <div class="control column is-6">
                            <a class="button is-light is-fullwidth {% if request.filter is not defined %}is-static{% endif %}"
                               href="{{ ag_run(agActionUrl, 'grid', {'filter': null}) }}"
                            >
                                {{- 'f0ska.autogrid.button.reset'|trans -}}
                            </a>
                        </div>
                    </div>
                </div>
            </details>
        {% endblock %}
    {% else %}
    {% block autogrid_grid_advanced_filter_modal %}
        <div id="adv{{ agId }}" class="modal">
            {% block autogrid_grid_advanced_filter_dialog %}
                <div class="modal-background" onclick="document.getElementById('adv{{ agId }}').classList.remove('is-active');"></div>
                <style>
                    #adv{{ agId }} .modal-card {
                        max-width: 90vw;
                        width: 1200px;
                    }
                </style>
                <div class="modal-card">
                    {% block autogrid_grid_advanced_filter_content %}
                        <header class="modal-card-head">
                            {% block autogrid_grid_advanced_filter_header %}
                                <p class="modal-card-title" id="adv{{ agId }}Label">
                                    {{ ag_icons.filter() }}
                                    {{ 'f0ska.autogrid.button.filter'|trans }}
                                </p>
                                <button class="delete" aria-label="close" onclick="document.getElementById('adv{{ agId }}').classList.remove('is-active');"></button>
                            {% endblock %}
                        </header>
                        <section class="modal-card-body">
                            {% block autogrid_grid_advanced_filter_body %}
                                {% if view.formThemes is not empty %}
                                    {% form_theme view.advancedFilterFormView with view.formThemes %}
                                {% endif %}
                                {% block autogrid_grid_advanced_filter_form %}
                                    {{ form_start(view.advancedFilterFormView) }}
                                    {{ include(attributes.template.grid.advanced_filter_fields|default(ag_template('grid.advanced_filter_fields'))) }}
                                    {{ form_rest(view.advancedFilterFormView) }}
                                    {{ form_end(view.advancedFilterFormView) }}
                                {% endblock %}
                            {% endblock %}
                        </section>
                        <footer class="modal-card-foot">
                            {% block autogrid_grid_advanced_filter_footer %}
                                <div class="column is-6">
                                    {% block autogrid_grid_advanced_filter_submit_button %}
                                        <button type="submit"
                                                form="{{ view.advancedFilterFormView.vars.attr.id }}"
                                                class="button is-primary is-fullwidth"
                                        >
                                            {{- 'f0ska.autogrid.button.submit'|trans -}}
                                        </button>
                                    {% endblock %}
                                </div>
                                <div class="column is-6">
                                    {% block autogrid_grid_advanced_filter_reset_button %}
                                        <a class="button is-light is-fullwidth {% if request.filter is not defined %}is-static{% endif %}"
                                           href="{{ ag_run(agActionUrl, 'grid', {'filter': null}) }}"
                                        >
                                            {{- 'f0ska.autogrid.button.reset'|trans -}}
                                        </a>
                                    {% endblock %}
                                </div>
                            {% endblock %}
                        </footer>
                    {% endblock %}
                </div>
            {% endblock %}
        </div>
    {% endblock %}
    {% endif %}
{% endif %}
