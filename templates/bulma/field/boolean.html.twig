{% import attributes.template.icons|default(ag_template('icons')) as ag_icons %}
{% block autogrid_field_boolean_content %}
    <span class="is-inline-flex is-align-items-center" style="gap: 0.4rem; cursor: default;">
        <span class="tag {{ value ? 'is-success is-light' : 'is-light' }} is-flex is-align-items-center is-justify-content-center" style="width: 1.2rem; height: 1.2rem; padding: 0; border-radius: 4px; font-size: 0.75rem;">
            <span class="icon is-small is-inline-flex">{{ value ? ag_icons.boolean_true() : ag_icons.boolean_false() }}</span>
        </span>
        <span class="{{ value ? 'has-text-dark' : 'has-text-grey' }}">
            {{- (value ? 'f0ska.autogrid.choice.yes' : 'f0ska.autogrid.choice.no')|trans -}}
        </span>
    </span>
{% endblock %}
